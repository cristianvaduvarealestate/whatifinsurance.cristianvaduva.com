{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "whatifinsurance-cristianvaduva-com",
  "main": ".open-next/worker.js",
  "upload_source_maps": true,
  "compatibility_date": "2024-09-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
